{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "VENV Mkdoc: Serve Local 8080",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-ExecutionPolicy",
                "RemoteSigned",
                "-Command",
                "& { .\\.venv\\Scripts\\Activate.ps1; mkdocs serve -a 127.0.0.1:8080 }"
            ],
        },
        {
            "label": "VENV Mkdoc: Serve Local 8000",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-ExecutionPolicy",
                "RemoteSigned",
                "-Command",
                "& { .\\.venv\\Scripts\\Activate.ps1; mkdocs serve -a 127.0.0.1:8000 }"
            ],
        },        
        {
            "label": "VENV Mkdoc: Serve Remote 8000",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-ExecutionPolicy",
                "RemoteSigned",
                "-Command",
                "& { .\\.venv\\Scripts\\Activate.ps1; mkdocs serve -a 0.0.0.0:8000 }"
            ],
        },
        {
            "label": "VENV Mkdoc: Serve Remote 8080",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-ExecutionPolicy",
                "RemoteSigned",
                "-Command",
                "& { .\\.venv\\Scripts\\Activate.ps1; mkdocs serve -a 0.0.0.0:8080 }"
            ],
        },        
        {
            "label": "VENV Mkdoc: Build",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-ExecutionPolicy",
                "RemoteSigned",
                "-Command",
                "& { .\\.venv\\Scripts\\Activate.ps1; mkdocs build  }"
            ],
        },       
        {
            "label": "VENV Mkdoc: Build strict",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-ExecutionPolicy",
                "RemoteSigned",
                "-Command",
                "& { .\\.venv\\Scripts\\Activate.ps1; mkdocs build --strict }"
            ],
        },
        {
            "label": "Pandoc: tool_pandoc.md to DOCX",
            "type": "shell",
            "command": "pandoc",
            "args": [
                ".\\docs\\tool_pandoc.md",
                "--toc",
                "--number-sections",
                "--reference-doc=.\\pandoc\\reference\\reference.docx",
                "--resource-path=.\\docs",
                "-o",
                ".\\pandoc\\output\\tool_pandoc.docx"
            ]
        },    
        {
            "label": "Pandoc: tool_pandoc.md (Lua filter) to DOCX",
            "type": "shell",
            "command": "pandoc",
            "args": [
                ".\\docs\\tool_pandoc.md",
                "--toc",
                "--metadata-file=.\\pandoc\\lua\\signature.yaml",
                "--lua-filter=.\\pandoc\\lua\\signature.lua",
                "--lua-filter=.\\pandoc\\lua\\information.lua",  
                "--lua-filter=.\\pandoc\\lua\\test_result.lua",    
                "--lua-filter=.\\pandoc\\lua\\table-width.lua",                                                 
                "--number-sections",
                "--reference-doc=.\\pandoc\\reference\\reference.docx",
                "--resource-path=.\\docs",
                "-o",
                ".\\pandoc\\output\\tool_pandoc_lua.docx"
            ]
        },      
        {
            "label": "Pandoc: tool_pandoc.md (Lua filter) to HTML",
            "type": "shell",
            "command": "pandoc",
            "args": [
                ".\\docs\\tool_pandoc.md",
                "--standalone",
                "--toc",
                "--metadata-file=.\\pandoc\\lua\\signature.yaml",
                "--lua-filter=.\\pandoc\\lua\\signature.lua",
                "--lua-filter=.\\pandoc\\lua\\information.lua",
                "--lua-filter=.\\pandoc\\lua\\test_result.lua",
                "--lua-filter=.\\pandoc\\lua\\table-width.lua",
                "--number-sections",
                "--resource-path=.\\docs",
                "-o",
                ".\\pandoc\\output\\tool_pandoc_lua.html"
            ]
        },
        {
            "label": "Pandoc: test_ppt.md to PPTX",
            "type": "shell",
            "command": "pandoc",
            "args": [
                ".\\pandoc\\test_ppt.md",
                "--standalone",
                "--toc",
                "--toc-depth=1",
                "--slide-level=0",      
                "--reference-doc=.\\pandoc\\reference\\reference.pptx",
                "--resource-path=.\\pandoc",
                "-o",
                ".\\pandoc\\output\\test_ppt.pptx"
            ]
        },                  
        {
            "label": "Mermaid: Convert test.md to SVG",
            "type": "shell",
            "command": "npx",
            "args": [
                "-p",
                "@mermaid-js/mermaid-cli",
                "mmdc",
                "-i",
                ".\\pandoc\\mmd\\test.md",
                "-o",
                ".\\pandoc\\imgs\\test.svg",
                "-b",
                "transparent"
            ],
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            }
        },            
        {
            "label": "Mermaid: Convert test_handdrawn.md to SVG",
            "type": "shell",
            "command": "npx",
            "args": [
                "-p",
                "@mermaid-js/mermaid-cli",
                "mmdc",
                "-i",
                ".\\pandoc\\mmd\\test_handdrawn.md",
                "-o",
                ".\\pandoc\\imgs\\test_handdrawn.svg",
                "-b",
                "transparent"
            ],
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            }
        },   
        {
            "label": "Mermaid: Convert test_general.md to SVG",
            "type": "shell",
            "command": "npx",
            "args": [
                "-p",
                "@mermaid-js/mermaid-cli",
                "mmdc",
                "-i",
                ".\\pandoc\\mmd\\test_general.md",
                "-o",
                ".\\pandoc\\imgs\\test_general.svg",
                "-b",
                "transparent"
            ],
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            }
        },                   
        {
            "label": "Package : Mkdocs to Electron",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}/electron_package.ps1"
            ],
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": []
        },   
        {
            "label": "Git: Show Local Config",
            "type": "shell",
            "command": "git config --local --list",
            "problemMatcher": []
        },
        {
            "label": "Git: Show Remotes",
            "type": "shell",
            "command": "git remote -v",
            "problemMatcher": []
        },                   
                    
    ]
}
