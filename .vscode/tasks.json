{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "VENV mkdoc serve Local",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-ExecutionPolicy",
                "RemoteSigned",
                "-Command",
                "& { .\\.venv\\Scripts\\Activate.ps1; mkdocs serve -a 127.0.0.1:8080 }"
            ],
        },
        {
            "label": "VENV mkdoc serve Remote",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-ExecutionPolicy",
                "RemoteSigned",
                "-Command",
                "& { .\\.venv\\Scripts\\Activate.ps1; mkdocs serve -a 0.0.0.0:8000 }"
            ],
        },
        {
            "label": "VENV mkdoc build",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-ExecutionPolicy",
                "RemoteSigned",
                "-Command",
                "& { .\\.venv\\Scripts\\Activate.ps1; mkdocs build  }"
            ],
        },       
        {
            "label": "VENV mkdoc build strict",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-ExecutionPolicy",
                "RemoteSigned",
                "-Command",
                "& { .\\.venv\\Scripts\\Activate.ps1; mkdocs build --strict }"
            ],
        },
        {
            "label": "Pandoc: Tool Pandoc",
            "type": "shell",
            "command": "pandoc",
            "args": [
                ".\\docs\\tool_pandoc.md",
                "--toc",
                "--number-sections",
                "--reference-doc=.\\docx\\tool_pandoc.docx",
                "--resource-path=.\\docs",
                "-o",``
                ".\\output\\tool_pandoc.docx"
            ]
        },     
        {
            "label": "Mermaid: Convert test.md to SVG",
            "type": "shell",
            "command": "npx",
            "args": [
                "-p",
                "@mermaid-js/mermaid-cli",
                "mmdc",
                "-i",
                ".\\docx\\mmd\\test.md",
                "-o",
                ".\\docx\\imgs\\test.svg",
                "-b",
                "transparent"
            ],
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            }
        },            
        {
            "label": "Mermaid: Convert test_handdrawn.md to SVG",
            "type": "shell",
            "command": "npx",
            "args": [
                "-p",
                "@mermaid-js/mermaid-cli",
                "mmdc",
                "-i",
                ".\\docx\\mmd\\test_handdrawn.md",
                "-o",
                ".\\docx\\imgs\\test_handdrawn.svg",
                "-b",
                "transparent"
            ],
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            }
        },   
        {
            "label": "Mermaid: Convert test_general.md to SVG",
            "type": "shell",
            "command": "npx",
            "args": [
                "-p",
                "@mermaid-js/mermaid-cli",
                "mmdc",
                "-i",
                ".\\docx\\mmd\\test_general.md",
                "-o",
                ".\\docx\\imgs\\test_general.svg",
                "-b",
                "transparent"
            ],
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            }
        },                   
        {
            "label": "Package Electron",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}/electron_package.ps1"
            ],
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": []
        },        
                    
    ]
}